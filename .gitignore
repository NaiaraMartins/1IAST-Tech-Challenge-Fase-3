# Ambiente virtual
.venv/

# Credenciais GCP
credentials/

# Estudos Optuna (recriáveis via src/ml/tune.py)
reports/*.db

# Configurações locais do VS Code
.vscode/

# Cache do Python
__pycache__/
*.py[codz]
*$py.class

# Arquivos temporários
*.log

# Arquivos de sistema
.DS_Store
Thumbs.db

# Dados gerados durante a execução
data/**/*.parquet

# Modelos treinados
models/

# Arquivos de ambiente
.env
.envrc

# Resultados parciais do Optuna (consolidados em optuna_best_params.json)
reports/optuna_partial_*.json
